# Copy with scripts/initialize-local-docker.ps1. Never commit the generated file.
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_PASSWORD=replace-with-a-distinct-random-runtime-password
WORKER_DATABASE_PASSWORD=replace-with-a-distinct-random-worker-password
AUDIT_HMAC_KEY=replace-with-a-distinct-random-secret
JWT_SIGNING_KEY=replace-with-a-distinct-random-secret
REFRESH_TOKEN_PEPPER=replace-with-a-distinct-random-secret
OTP_HMAC_KEY=replace-with-a-distinct-random-secret
MFA_ENCRYPTION_KEY=replace-with-a-fernet-key
WORKER_USER_ID=00000000-0000-0000-0000-000000000001
EVENT_DELIVERY_URL=https://127.0.0.1:9443/events
EVENT_DELIVERY_TOKEN=replace-with-a-distinct-random-secret
